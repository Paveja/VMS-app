# Inject real values. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/dealerflow
TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@127.0.0.1:5432/dealerflow_test
PORT=4174
