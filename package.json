{
  "name": "dealerflow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/api/src/server.ts\" \"vite --config apps/web/vite.config.ts --host 0.0.0.0 --port 4173\"",
    "start": "node --import tsx apps/api/src/server.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write apps packages scripts *.{json,ts,yml,md}",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:showcase": "tsx scripts/showcase.ts",
    "db:provision": "node scripts/provision.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "latest",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "latest",
    "clsx": "latest",
    "dotenv": "latest",
    "drizzle-orm": "^0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "pg": "latest",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "latest",
    "recharts": "latest",
    "tailwindcss": "4.3.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "^22.0.0",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "8.3.8",
    "vitest": "latest"
  }
}
